# Copy to .env next to docker-compose.yml; `docker compose` reads it for every
# command (up, down, logs, ...). Keep .env out of version control.

# Required: shared password for the web UI, API and WebSocket.
# Generate one with: openssl rand -hex 16
DASHBOARD_SECRET=

# Required: absolute path to the directory agents may work in,
# e.g. /home/you/projects. Left empty so compose refuses to start until set.
PROJECT_ROOT=

# Needed for the claude CLI inside the container.
ANTHROPIC_API_KEY=

# User the server and agents run as; on Linux use your own `id -u` / `id -g`.
PUID=1000
PGID=1000

# Optional limits (defaults shown).
# MAX_RUN_MINUTES=30
# AI_SELECT_TIMEOUT_MS=180000
